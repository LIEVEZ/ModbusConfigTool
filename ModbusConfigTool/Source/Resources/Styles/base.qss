QWidget {
    background: #f2f1ed;
    color: #26251e;
    font: 13px "Segoe UI", "Microsoft YaHei";
}
QMainWindow, QMenuBar, QMenu, QStatusBar {
    background: #f7f7f4;
}
QWidget#workspaceRoot {
    background: #f2f1ed;
}
QToolBar#workspaceToolBar {
    min-height: 48px;
    padding: 0 14px;
    spacing: 10px;
    background: #f7f7f4;
    border: 0;
    border-bottom: 1px solid rgba(38, 37, 30, 24);
}
QLabel#groupCountBadge, QLabel#portCountBadge {
    padding: 0 10px;
    border-radius: 10px;
    color: #f54e00;
    background: #f3dfd4;
}
QSplitter#workspaceSplitter::handle {
    width: 1px;
    background: rgba(38, 37, 30, 24);
}
QWidget#connectionPortList, QWidget#portListHeader, QWidget#portListContent,
QScrollArea#portListScrollArea, QScrollArea#groupCanvasScrollArea {
    background: #f7f7f4;
    border: 0;
}
QScrollArea#portListScrollArea {
    background: #f7f7f4;
}
QScrollArea#portListScrollArea QWidget#portListContent {
    background: #f7f7f4;
}
QWidget#portListHeader {
    border-bottom: 1px solid rgba(38, 37, 30, 24);
}
QLabel#portListEyebrow, QLabel#portConnectionSummary,
QLabel#portMeta, QLabel#emptyPortHint {
    color: rgba(38, 37, 30, 140);
    background: transparent;
}
QLabel#portListTitle {
    font: 600 17px "Bahnschrift", "Segoe UI";
    background: transparent;
}
QLabel#portName {
    font: 600 15px "Segoe UI", "Microsoft YaHei";
    background: transparent;
}
QLabel#portTypeBadge {
    padding: 2px 8px;
    border-radius: 5px;
    color: rgba(38, 37, 30, 160);
    background: rgba(38, 37, 30, 16);
}
QLabel#portConnectionSummary, QLabel#portMeta {
    margin-left: 0px;
    padding-left: 0px;
}
QLabel#portConnectionSummary {
    font-family: Consolas, "Cascadia Mono", monospace;
    font-size: 11px;
}
QLabel#portMeta {
    font-size: 11px;
}
QLabel#portName {
    min-width: 0;
}
QLabel#portTypeBadge {
    min-width: 36px;
    max-height: 22px;
    padding: 1px 6px;
}
QWidget#eventLogView, QWidget#eventLogHeader, QPlainTextEdit#eventLogConsole {
    background: #f7f7f4;
}
QWidget#eventLogHeader {
    border-bottom: 1px solid rgba(38, 37, 30, 24);
}
QLabel#eventLogEyebrow {
    color: rgba(38, 37, 30, 140);
    background: transparent;
}
QLabel#eventLogTitle {
    font: 600 17px "Bahnschrift", "Segoe UI";
    background: transparent;
}
QWidget#eventLogTitleRow {
    background: transparent;
}
QPushButton#eventLogClearButton {
    min-width: 52px;
    min-height: 24px;
    max-height: 26px;
    padding: 2px 10px;
    color: rgba(38, 37, 30, 180);
    background: #ffffff;
    border: 1px solid rgba(38, 37, 30, 28);
    border-radius: 8px;
    font-size: 12px;
}
QPushButton#eventLogClearButton:hover {
    color: #f54e00;
    border-color: #f54e00;
    background: #fffaf7;
}
QPushButton#eventLogClearButton:pressed {
    background: #f3dfd4;
}
QPlainTextEdit#eventLogConsole {
    padding: 12px 14px;
    border: 0;
    color: rgba(38, 37, 30, 190);
    font: 12px Consolas, monospace;
}
QWidget#eventLogFilterRow {
    background: transparent;
}
QComboBox#eventLogFilterLevel, QLineEdit#eventLogFilterText {
    min-height: 24px;
    padding: 2px 8px;
    color: rgba(38, 37, 30, 180);
    background: #ffffff;
    border: 1px solid rgba(38, 37, 30, 28);
    border-radius: 8px;
    font-size: 12px;
}
QComboBox#eventLogFilterLevel {
    min-width: 88px;
}
QComboBox#eventLogFilterLevel:focus, QLineEdit#eventLogFilterText:focus {
    border-color: #f54e00;
}
QLabel#eventLogFilterCount {
    color: rgba(38, 37, 30, 140);
    background: transparent;
    font-size: 12px;
}
QWidget#card, QWidget#runtimeControlCard {
    background: #ebeae5;
    border: 1px solid rgba(38, 37, 30, 28);
    border-radius: 10px;
}
QLabel#sectionTitle {
    font: 20px "Bahnschrift", "Segoe UI";
    background: transparent;
}
QLabel#successBadge, QLabel#warningBadge {
    border-radius: 10px;
    padding: 4px 9px;
}
QLabel#successBadge { color: #1f8a65; background: rgba(31, 138, 101, 28); }
QLabel#warningBadge { color: #c08532; background: rgba(192, 133, 50, 34); }

QLabel#workspaceHintBadge {
    padding: 0 12px;
    border-radius: 999px;
    color: rgba(38, 37, 30, 150);
    background: #f7f7f4;
    border: 1px solid rgba(38, 37, 30, 28);
    font-size: 12px;
}
QLabel#groupCountBadge, QLabel#portCountBadge {
    padding: 0 10px;
    border-radius: 999px;
    color: rgba(38, 37, 30, 150);
    background: #f7f7f4;
    border: 1px solid rgba(38, 37, 30, 28);
}

QDialog#commMonitorDialog {
    background: #f2f1ed;
}
QWidget#commMonitorView,
QWidget#commMonitorToolBar {
    background: transparent;
}
QComboBox#commMonitorPortCombo {
    min-height: 28px;
    min-width: 160px;
    padding: 4px 8px;
    background: #ffffff;
}
QLabel#commMonitorPortLabel {
    font: 600 14px "Segoe UI", "Microsoft YaHei";
    background: transparent;
}
QLabel#commMonitorHintLabel {
    color: rgba(38, 37, 30, 140);
    font-size: 12px;
    background: transparent;
}
QTableWidget#commMonitorTable {
    background: #ffffff;
    border: 1px solid rgba(38, 37, 30, 22);
    gridline-color: rgba(38, 37, 30, 18);
    font: 12px Consolas, "Cascadia Mono", monospace;
}
QTableWidget#commMonitorTable::item {
    padding: 4px 6px;
}
QPushButton#commMonitorPauseButton,
QPushButton#commMonitorClearButton,
QPushButton#commMonitorCopyButton {
    min-width: 64px;
}
